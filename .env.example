# Apify
APIFY_TOKEN=
# Optional — defaults to apify/website-content-crawler
APIFY_WEBSITE_CRAWLER_ACTOR_ID=
# Crawler engine: cheerio (cheap, no JS) | playwright:adaptive (renders JS — needed for floor-plan images)
APIFY_CRAWLER_TYPE=cheerio
# Optional proxy groups (e.g. RESIDENTIAL) to bypass anti-bot 403s on managed-property sites
APIFY_PROXY_GROUPS=

# Box
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_DEVELOPER_TOKEN=
BOX_ROOT_FOLDER_ID=

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to use per node (openai | anthropic)
TEXT_LLM_PROVIDER=openai
VISION_LLM_PROVIDER=openai
JUDGE_LLM_PROVIDER=anthropic

# Dev flags
DEMO_MODE=true           # true = return mock data without running the pipeline (frontend dev)
USE_CACHED_APIFY=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000
